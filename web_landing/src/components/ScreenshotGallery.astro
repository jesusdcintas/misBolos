---
<section id="capturas" class="gallery-section">
  <div class="container">
    <div class="section-intro text-center">
      <span class="tag">Galería de Capturas</span>
      <h2>Explora la interfaz real de MisBolos</h2>
      <p class="lead container-narrow">
        Descubre cómo se ve y funciona la aplicación en el día a día. Selecciona una categoría para ver las distintas pantallas.
      </p>
    </div>

    <!-- Pestañas Interactivas -->
    <div class="tabs-container">
      {categories.map((cat, idx) => (
        <button 
          class={`tab-btn ${idx === 0 ? "active" : ""}`} 
          data-target={cat.id}
          role="tab"
          aria-selected={idx === 0 ? "true" : "false"}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Contenedor de Rejilla de Imágenes -->
    <div class="gallery-grid">
      {screenshots.map((screen) => {
        const isInitial = screen.category === "agenda-panel";
        return (
          <div 
            class={`gallery-card ${isInitial ? "" : "hidden"}`} 
            data-category={screen.category}
          >
            <div class="mockup-container">
              <div class="phone-frame">
                <div class="phone-speaker"></div>
                <div class="phone-screen">
                  
                  <img 
                    src={`/screenshots/${screen.filename}`} 
                    alt={`Captura de pantalla de ${screen.title} en MisBolos`}
                    class="mockup-img loaded"
                    loading="lazy"
                  />
                  
                </div>
                <div class="phone-home-indicator"></div>
              </div>
            </div>
            <div class="card-info">
              <h4>{screen.title}</h4>
              <p>{screen.description}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.gallery-card');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // 1. Quitar activo de todos los botones y establecer en el pulsado
      buttons.forEach(btn => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
      });
      button.classList.add('active');
      button.setAttribute('aria-selected', 'true');

      // 2. Filtrar tarjetas
      const targetCategory = button.getAttribute('data-target');
      
      cards.forEach((card: any) => {
        const cardCategory = card.getAttribute('data-category');
        if (cardCategory === targetCategory) {
          card.classList.remove('hidden');
          // Disparar una micro-animación de entrada
          card.style.animation = 'none';
          card.offsetHeight; /* trigger reflow */
          card.style.animation = 'cardFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards';
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .gallery-section {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  /* Pestañas */
  .tabs-container {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
    margin-bottom: 60px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 16px;
  }

  .tab-btn {
    background: transparent;
    border: none;
    padding: 10px 20px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #718096;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    position: relative;
  }

  .tab-btn:hover {
    color: var(--color-primary-dark);
    background-color: var(--color-soft-blue);
  }

  .tab-btn.active {
    color: var(--color-primary);
  }

  .tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -17px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--color-primary);
    border-radius: 999px;
  }

  /* Rejilla de tarjetas */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    min-height: 450px;
  }

  @media (max-width: 992px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px 24px 24px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .gallery-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .gallery-card.hidden {
    display: none !important;
  }

  /* Animación de entrada */
  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Mockup de Teléfono Móvil Sobrio */
  .mockup-container {
    width: 100%;
    max-width: 220px;
    margin-bottom: 24px;
  }

  .phone-frame {
    background-color: #1E293B;
    border: 8px solid #0F172A;
    border-radius: 36px;
    padding: 6px;
    position: relative;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 9 / 19;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .phone-speaker {
    width: 50px;
    height: 4px;
    background-color: #334155;
    border-radius: 99px;
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }

  .phone-screen {
    flex: 1;
    background-color: #F8FAFC;
    border-radius: 26px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .phone-home-indicator {
    width: 70px;
    height: 3px;
    background-color: #475569;
    border-radius: 99px;
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }

  /* Imagen Real */
  .mockup-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 5;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .mockup-img.loaded {
    opacity: 1;
  }

  /* Info de tarjeta */
  .card-info {
    text-align: center;
  }

  .card-info h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--color-primary-dark);
  }

  .card-info p {
    font-size: 0.85rem;
    color: #718096;
    line-height: 1.5;
  }
</style>
