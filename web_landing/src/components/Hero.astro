---
---
<section id="inicio" class="hero-section">
  <div class="container text-center">
    <h1 class="hero-title">MisBolos</h1>
    <p class="hero-subtitle">Agenda, facturas y finanzas para DJs autónomos.</p>
    <p class="hero-description container-narrow">
      Controla bolos, clientes, cobros, gastos e impuestos desde una sola herramienta. Diseñada para adaptarse al ritmo de la cabina y ayudarte a organizar tu negocio.
    </p>
    
    <div class="hero-actions">
      <a href="#funciones" class="btn btn-primary">Explorar funciones</a>
      <a href="#capturas" class="btn btn-secondary">Ver capturas</a>
    </div>

    <!-- Contenedor del Vídeo / Mockup Fallback -->
    <div class="hero-media-wrapper">
      <div class="device-mockup">
        <div class="mockup-header">
          <div class="mockup-dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>
          <div class="mockup-address">misbolos.app/dashboard</div>
        </div>
        
        <div class="mockup-content">
          <!-- El vídeo se renderiza encima si existe -->
          <video 
            src="/video/promo.mp4" 
            class="promo-video" 
            autoplay 
            muted 
            loop 
            playsinline 
            aria-label="Vídeo de demostración de la aplicación MisBolos"
          >
            <!-- Si el navegador no soporta vídeo, o el vídeo no carga, se ve la interfaz de abajo -->
          </video>

          <!-- Interfaz Simulada (Fallback elegante y sobrio cuando no hay video) -->
          <div class="video-fallback">
            <span class="video-fallback-title">Vídeo de presentación pendiente</span>
            <span class="video-fallback-filename">promo.mp4</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-color: var(--color-bg);
    padding: 100px 24px 120px;
    overflow: hidden;
  }

  .hero-title {
    font-size: 4.5rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    margin-bottom: 16px;
    letter-spacing: -0.04em;
  }

  .hero-subtitle {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: 1.15rem;
    color: #4A5568;
    margin-bottom: 40px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 70px;
  }

  @media (max-width: 600px) {
    .hero-title {
      font-size: 3.25rem;
    }
    .hero-subtitle {
      font-size: 1.5rem;
    }
    .hero-actions {
      flex-direction: column;
      gap: 12px;
      padding: 0 16px;
    }
  }

  /* Contenedor del dispositivo */
  .hero-media-wrapper {
    max-width: 960px;
    margin: 0 auto;
    perspective: 1000px;
  }

  .device-mockup {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    aspect-ratio: 16 / 10;
    width: 100%;
    position: relative;
  }

  .mockup-header {
    height: 40px;
    background-color: #F1F3F5;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    padding: 0 16px;
    position: relative;
  }

  .mockup-dots {
    display: flex;
    gap: 6px;
    position: absolute;
    left: 16px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #D1D5DB;
  }

  .dot:nth-child(1) { background-color: #FF5F56; }
  .dot:nth-child(2) { background-color: #FFBD2E; }
  .dot:nth-child(3) { background-color: #27C93F; }

  .mockup-address {
    margin: 0 auto;
    font-size: 0.75rem;
    color: #9CA3AF;
    background-color: var(--color-surface);
    padding: 4px 32px;
    border-radius: var(--radius-sm);
    border: 1px solid #E5E7EB;
    font-family: monospace;
  }

  .mockup-content {
    flex: 1;
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  /* Vídeo */
  .promo-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
    background: transparent;
  }

  /* Fallback Mockup CSS */
  /* Fallback Video CSS */
  .video-fallback {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #EEF1F7;
    font-family: var(--font-sans);
    text-align: center;
    padding: 24px;
  }

  .video-fallback-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-dark);
  }

  .video-fallback-filename {
    font-size: 0.9rem;
    font-family: monospace;
    color: #718096;
    margin-top: 8px;
  }
</style>
